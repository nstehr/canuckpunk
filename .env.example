# Copy to .env.local and fill in. The Makefile includes .env.local if present;
# .env.local is gitignored, so nothing about a particular server is committed.

# --- Deployment target ------------------------------------------------------

# The droplet's address, as an IP or a hostname.
# (203.0.113.10 is RFC 5737 documentation space — replace it.)
DROPLET_HOST=203.0.113.10

# The account `make deploy` logs in as. Needs root (it writes to
# /usr/local/bin and manages systemd).
DROPLET_USER=root

# Private key for that login. A leading ~/ is expanded by the Makefile.
DROPLET_SSH_KEY=~/.ssh/id_droplet

# Port sshd listens on, if it is not 22.
#DROPLET_SSH_PORT=22

# Architecture of the target host. DigitalOcean droplets are amd64 unless you
# chose an ARM plan.
#DEPLOY_GOARCH=amd64

# --- Local development ------------------------------------------------------

# Where the local SQLite database lives.
#CANUCKPUNK_DB=canuckpunk.db

# --- Discord ----------------------------------------------------------------

# Bot token, from https://discord.com/developers/applications → your app → Bot
# → Reset Token. A secret: anyone holding it controls the bot.
#
# Leave this EMPTY to run SSH-only. A token that is set but invalid aborts
# startup, which is deliberate — a misconfigured deploy should not half-run.
DISCORD_TOKEN=

# Your server's id. Discord: Settings → Advanced → Developer Mode, then
# right-click the server name → Copy Server ID.
#
# With a guild set, slash commands register to it and appear instantly.
# Without one they register globally and can take up to an hour to propagate.
DISCORD_GUILD_ID=

# The channel `-post-lobby` puts the pinned Begin button in. Right-click the
# channel → Copy Channel ID.
DISCORD_START_CHANNEL_ID=
